<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.logInController"
            prefWidth="400" prefHeight="300">

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="50"
          AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50"
          AnchorPane.bottomAnchor="50">

        <Label text="Administrator Login" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextField fx:id="usernameField" promptText="Username" />
        <PasswordField fx:id="passwordField" promptText="Password" />

        <Button text="Login" onAction="#handleLogin" prefWidth="150" />
        <Label fx:id="messageLabel" textFill="red" />
    </VBox>

</AnchorPane>
